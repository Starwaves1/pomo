#!/usr/bin/env python3
"""
pomo — Pomodoro timer for the terminal, with a braille progress bar.

  pomo        set up this session and start it
  pomo help   what the keys do and where settings live

Five questions, each pre-filled with the session you ran last, so pressing
Enter five times repeats it exactly. Anything unparseable keeps the default.
"""

__version__ = "2.0.0"

import configparser
import os
import shutil
import subprocess
import sys
import threading
import time
from contextlib import contextmanager
from datetime import datetime, timedelta
from pathlib import Path

WINDOWS = os.name == "nt"

if WINDOWS:
    import msvcrt
else:
    import select
    import termios
    import tty

# ── Colors ──────────────────────────────────────────────────────────────────

RESET, BOLD, DIM = "\033[0m", "\033[1m", "\033[2m"
HIDE, SHOW, CLEAR, UP = "\033[?25l", "\033[?25h", "\033[K", "\033[A"
ALT, ALT_OFF = "\033[?1049h", "\033[?1049l"   # the alternate screen buffer
HOME, ERASE_BELOW = "\033[H", "\033[J"

def fg(n):
    return f"\033[38;5;{n}m"

CORAL, MINT, SKY = fg(210), fg(120), fg(117)
GOLD, PINK, WHITE = fg(222), fg(218), fg(231)

# Every bar colour has a matching rail — a muted version of the same hue — so
# the unfilled part belongs to the bar instead of fading into grey.
RAILS = {CORAL: fg(95), MINT: fg(65), SKY: fg(60)}

def c(text, color):
    return f"{color}{text}{RESET}"

# ── Finding a sound ─────────────────────────────────────────────────────────
#
# Every desktop ships sounds, just in different places and formats. Looking
# them up here — above the settings — lets the first-run default be a file we
# have actually confirmed exists, so pomo rings on a fresh install everywhere.

SOUND_DIRS = ["/System/Library/Sounds",                  # macOS
              "/usr/share/sounds/freedesktop/stereo",    # most Linux desktops
              "C:/Windows/Media"]                        # Windows
SOUND_EXTS = [".wav", ".aiff", ".oga", ".ogg", ".mp3"]

# Tried in order; the first one present becomes the default on a fresh install.
CANDIDATES = {
    "darwin": ["Glass", "Ping", "Submarine"],
    "nt": ["Windows Notify System Generic", "chimes", "notify", "ding", "tada"],
}.get("nt" if WINDOWS else sys.platform, ["complete", "bell", "message"])

def sound_file(name):
    """A bundled sound by bare name, a path of your own, or None for silence."""
    if not name:
        return None
    if Path(name).expanduser().is_file():
        return str(Path(name).expanduser())
    for folder in SOUND_DIRS:
        for ext in SOUND_EXTS:
            if (candidate := Path(folder) / f"{name}{ext}").is_file():
                return str(candidate)
    return None

DEFAULT_SOUND = next((n for n in CANDIDATES if sound_file(n)), "")

# ── Settings ────────────────────────────────────────────────────────────────
#
# One file, rewritten from this template after every run — so it always holds
# your last session, and the comments survive being machine-written.

PATH = Path.home() / ".config" / "pomo" / "pomo.ini"

TEMPLATE = """\
# pomo — rewritten after each run, so this is always your last session.
# Durations are in seconds; the setup prompts are the easy way to change them.

[session]
focus = {focus}
short_break = {short_break}
long_break = {long_break}
per_set = {per_set}
sessions = {sessions}

[sound]
# A bundled sound by name — macOS has Glass, Ping, Submarine, Hero, Funk;
# Linux has complete, bell, message; Windows has chimes, notify, ding, tada
# — or a path to any audio file of your own. Leave empty for silence.
# On Windows a .wav plays instantly but ignores volume; other formats honour
# it, so if you want quieter, pick a quieter file.
file = {file}
volume = {volume}

[display]
width = {width}
notify = {notify}
"""

# Glass exists on macOS, complete on freedesktop Linux — pick one that's there.
DEFAULT_SOUND = "Glass" if sys.platform == "darwin" else "complete"

DEFAULTS = {
    "focus": 1500, "short_break": 300, "long_break": 900,
    "per_set": 4, "sessions": 4,
    "file": DEFAULT_SOUND, "volume": "0.5", "width": 24, "notify": "yes",
}

def load():
    """Read every section into one flat dict, digits as ints."""
    cfg, parser = dict(DEFAULTS), configparser.ConfigParser()
    try:
        parser.read(PATH)
        for section in parser.sections():
            cfg.update(parser[section])
    except configparser.Error:
        pass  # a hand-mangled file shouldn't stop you working
    return {k: int(v) if str(v).isdigit() else v for k, v in cfg.items()}

def save(cfg):
    PATH.parent.mkdir(parents=True, exist_ok=True)
    PATH.write_text(TEMPLATE.format(**cfg))

# ── Durations ───────────────────────────────────────────────────────────────

UNITS = {"s": 1, "m": 60, "h": 3600}

def seconds(text):
    """'25' → 1500, '90s' → 90, '1h' → 3600. None if it isn't a duration."""
    text = text.strip().lower()
    unit = UNITS.get(text[-1:], 60)
    number = text[:-1] if text[-1:] in UNITS else text
    return int(float(number) * unit) if number.replace(".", "", 1).isdigit() else None

def span(secs):
    """1500 → '25m', 8100 → '2h 15m', 45 → '45s'."""
    if secs < 60:
        return f"{int(secs)}s"
    h, m = divmod(round(secs / 60), 60)
    return " ".join(p for p in (f"{h}h" if h else "", f"{m}m" if m else "") if p)

def mmss(secs):
    return f"{int(secs) // 60}:{int(secs) % 60:02d}"

def oclock(when):
    return when.strftime("%I:%M %p").lstrip("0")

# ── Braille bar ─────────────────────────────────────────────────────────────
#
# A braille cell is 2 columns × 4 rows of dots, so each character holds two
# horizontal half-steps — twice the resolution of a block bar the same width.
# The fill is bold to make the dots glow; the ⣀ rail carries the same hue.

def bar(progress, width, color):
    full, half = divmod(round(min(progress, 1) * width * 2), 2)
    return (c("⣿" * full + "⡇" * half, BOLD + color)
            + c("⣀" * (width - full - half), RAILS.get(color, DIM)))

def dots(done, per_set):
    filled = done % per_set or (per_set if done else 0)
    return c("●" * filled, BOLD + CORAL) + c("○" * (per_set - filled), RAILS[CORAL])

def row(label, color, progress, right, done, cfg):
    """Every line the timer draws, live or finished, has this shape."""
    return (f"  {c(label.ljust(10), BOLD + color)}{bar(progress, cfg['width'], color)}"
            f"  {right}  {dots(done, cfg['per_set'])}")

# ── Setup ───────────────────────────────────────────────────────────────────

def finishing(cfg):
    """How long the whole goal takes, and the clock time it lands on.

    Breaks only fall between sessions, so there are n-1 of them, every
    per_set'th one long.
    """
    n = cfg["sessions"]
    if not n:
        return f"{c('no end', WHITE)}  {DIM}runs until you quit{RESET}"

    longs = (n - 1) // cfg["per_set"]
    total = (n * cfg["focus"] + longs * cfg["long_break"]
             + (n - 1 - longs) * cfg["short_break"])
    end = oclock(datetime.now() + timedelta(seconds=total))
    return f"{c(span(total), WHITE)}  {DIM}·{RESET}  {c(end, WHITE)}"

def shown(cfg, key):
    if key == "sessions":
        return str(cfg[key]) if cfg[key] else "∞"
    return str(cfg[key]) if key == "per_set" else span(cfg[key])

FIELDS = [
    ("Focus", "focus", seconds),
    ("Short break", "short_break", seconds),
    ("Long break", "long_break", seconds),
    ("Focus per set", "per_set", str.isdigit),
    ("Sessions today", "sessions", str.isdigit),
]

def setup(cfg):
    """Ask the five questions, redrawing each answer in place once it lands."""
    print(f"\n  {c('🍅 pomo', BOLD + PINK)} {c('v' + __version__, DIM)}")
    print(f"  {DIM}Enter keeps the default · Ctrl+C to cancel{RESET}\n")

    for label, key, parse in FIELDS:
        was = shown(cfg, key)
        prompt = f"  {c(label.ljust(15), SKY)}{c(was.rjust(6), DIM)}  {c('▸', BOLD + PINK)} "
        try:
            answer = input(prompt).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            sys.exit(0)

        if parse is seconds:
            cfg[key] = seconds(answer) or cfg[key]
        elif answer.isdigit():
            cfg[key] = int(answer)

        note = f"   {finishing(cfg)}" if key == "sessions" else ""
        print(f"{UP}\r  {c(label.ljust(15), SKY)}{c(was.rjust(6), DIM)}"
              f"  {c('▸', BOLD + PINK)} {c(shown(cfg, key), BOLD + WHITE)}{note}{CLEAR}")

    return cfg

# ── Alarm ───────────────────────────────────────────────────────────────────
#
# Every desktop rings differently. Windows has a player built into Python;
# macOS and Linux ship command-line ones, discovered at runtime with which().
# On a machine with none of them, pomo simply runs quiet.

# volume arrives as 0.0–1.0; each player wants it on its own scale
PLAYERS = [
    ("afplay", lambda p, v: ["afplay", "-v", f"{v}", p]),
    ("paplay", lambda p, v: ["paplay", f"--volume={int(v * 65536)}", p]),
    ("ffplay", lambda p, v: ["ffplay", "-nodisp", "-autoexit", "-loglevel",
                             "quiet", "-volume", f"{int(v * 100)}", p]),
    ("mpv",    lambda p, v: ["mpv", "--really-quiet", f"--volume={int(v * 100)}", p]),
    ("aplay",  lambda p, v: ["aplay", "-q", p]),          # wav only, no volume
]

def command(path, volume):
    """The first player actually installed, ready to run."""
    for name, build in PLAYERS:
        if shutil.which(name):
            return build(path, float(volume))
    return None

def quietly(cmd):
    """Run a command in the background, with no console window on Windows."""
    threading.Thread(
        target=subprocess.run, args=(cmd,), daemon=True,
        kwargs={"capture_output": True,
                "creationflags": subprocess.CREATE_NO_WINDOW if WINDOWS else 0},
    ).start()

def ring(path, volume):
    """Play the alarm. Returns immediately either way."""
    if WINDOWS:
        # winsound is in the standard library and already asynchronous, so a
        # .wav needs no player, no subprocess and no console flash. It has no
        # volume control — that's why the default sound is a system .wav.
        if path.lower().endswith(".wav"):
            import winsound
            winsound.PlaySound(path, winsound.SND_FILENAME | winsound.SND_ASYNC)
        else:
            # mp3 and friends need a real decoder; PowerShell has one, and it
            # honours volume. Slower to start, so wav stays the good path.
            quietly(["powershell", "-NoProfile", "-Command",
                     "Add-Type -AssemblyName PresentationCore;"
                     "$p = New-Object System.Windows.Media.MediaPlayer;"
                     f"$p.Open([uri]'{path}'); $p.Volume = {float(volume)};"
                     "$p.Play(); Start-Sleep -Seconds 5"])
    elif cmd := command(path, volume):
        quietly(cmd)

def notify(label):
    """Post a desktop notification, if this machine has any way to."""
    if WINDOWS:
        quietly(["powershell", "-NoProfile", "-Command",
                 "[Windows.UI.Notifications.ToastNotificationManager,"
                 "Windows.UI.Notifications, ContentType=WindowsRuntime] > $null;"
                 "$x = [Windows.UI.Notifications.ToastNotificationManager]::"
                 "GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]"
                 "::ToastText02);"
                 "$t = $x.GetElementsByTagName('text');"
                 "$t[0].AppendChild($x.CreateTextNode('pomo')) > $null;"
                 f"$t[1].AppendChild($x.CreateTextNode('{label} done')) > $null;"
                 "[Windows.UI.Notifications.ToastNotificationManager]::"
                 "CreateToastNotifier('pomo').Show("
                 "[Windows.UI.Notifications.ToastNotification]::new($x))"])
    elif shutil.which("osascript"):
        quietly(["osascript", "-e",
                 f'display notification "{label} done" with title "🍅 pomo"'])
    elif shutil.which("notify-send"):
        quietly(["notify-send", "🍅 pomo", f"{label} done"])

def alarm(cfg, path, label):
    """Ring and notify without blocking the timer."""
    if path:
        ring(path, float(cfg["volume"]))
    if str(cfg["notify"]).lower() in ("yes", "true", "1"):
        notify(label)

# ── Screen ──────────────────────────────────────────────────────────────────

@contextmanager
def fullscreen():
    """Take over the window, and hand it back untouched on the way out."""
    sys.stdout.write(ALT)
    try:
        yield
    finally:
        sys.stdout.write(SHOW + ALT_OFF)
        sys.stdout.flush()

def paint(lines):
    """Repaint from the top. No clear first — erasing per line avoids flicker."""
    sys.stdout.write(HOME + "\n".join(l + CLEAR for l in lines) + ERASE_BELOW)
    sys.stdout.flush()

def screen(cfg, current, history):
    """Title pinned at the top, the interval running now, then what's finished."""
    goal = f"  {DIM}·{RESET}  goal {c(cfg['sessions'], BOLD + PINK)}" if cfg["sessions"] else ""
    head = [
        "",
        f"  {c('🍅 pomo', BOLD + PINK)}  {c(span(cfg['focus']), BOLD + CORAL)} focus"
        f"  {DIM}·{RESET}  {c(span(cfg['short_break']), BOLD + MINT)} break{goal}",
        "",
        current,
        "",
    ]
    foot = ["", f"  {DIM}space pause · s skip · r restart · q quit{RESET}"]

    room = shutil.get_terminal_size((80, 24)).lines - len(head) - len(foot) - 1
    return head + history[-room:] + foot

# ── Timer ───────────────────────────────────────────────────────────────────

def waiting(timeout):
    """Windows: poll for a keypress. select() only handles sockets there."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if msvcrt.kbhit():
            return msvcrt.getwch()
        time.sleep(0.01)
    return None

@contextmanager
def keyboard():
    """Single keypresses, no Enter. Yields a read(timeout) that paces the loop."""
    sys.stdout.write(HIDE)
    if WINDOWS:
        try:                            # no terminal mode to save or restore
            yield waiting
        finally:
            sys.stdout.write(SHOW)
        return

    saved = termios.tcgetattr(sys.stdin)
    tty.setcbreak(sys.stdin.fileno())  # leaves Ctrl+C working
    try:
        yield lambda t: (sys.stdin.read(1)
                         if select.select([sys.stdin], [], [], t)[0] else None)
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved)
        sys.stdout.write(SHOW)

def countdown(label, total, color, done, cfg, read, history):
    """Run one interval. Returns 'done', 'skip' or 'quit'."""
    left, paused, tick = total, False, time.monotonic()
    while left > 0:
        now = time.monotonic()
        left -= 0 if paused else now - tick
        tick = now

        text, hue = ("paused", GOLD) if paused else (label, color)
        paint(screen(cfg, row(text, hue, 1 - left / total,
                              c(mmss(max(left, 0)).rjust(5), BOLD + WHITE), done, cfg),
                     history))

        key = read(0.1)
        if key == " ":
            paused = not paused
        elif key in ("s", "S"):
            return "skip"
        elif key in ("q", "Q"):
            return "quit"
        elif key in ("r", "R"):
            left, tick = total, time.monotonic()
    return "done"

def intervals(cfg):
    """focus, break, focus, break… with a long break closing each set."""
    count = 0
    while True:
        yield "focus", cfg["focus"], CORAL, True
        count += 1
        if count % cfg["per_set"]:
            yield "break", cfg["short_break"], MINT, False
        else:
            yield "long break", cfg["long_break"], SKY, False

def run(cfg):
    """The session. Finished intervals stack up under the one running now."""
    path = sound_file(cfg["file"])
    history, done, focused = [], 0, 0

    with keyboard() as read:
        for label, length, color, is_focus in intervals(cfg):
            action = countdown(label, length, color, done, cfg, read, history)
            if action == "quit":
                break
            if action == "skip":
                continue

            if is_focus:
                done, focused = done + 1, focused + length
            history.append(
                row(label, color, 1, c(oclock(datetime.now()).rjust(5), DIM), done, cfg)
                + f"  {c('✓', MINT)}")
            alarm(cfg, path, label)

            if is_focus and cfg["sessions"] and done >= cfg["sessions"]:
                break

    return done, focused

# ── Help ────────────────────────────────────────────────────────────────────

