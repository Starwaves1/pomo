    print(f"""
  {c('🍅 pomo', BOLD + PINK)} {c('v' + __version__, DIM)} — Pomodoro timer with a braille progress bar

  {BOLD}USAGE{RESET}
    {c('pomo', MINT)}          set up this session, then start it
    {c('pomo help', MINT)}     this page

  {BOLD}SETUP{RESET}
    Five questions, each pre-filled with the session you ran last — so five
    Enters repeats it exactly. Answer durations as {c('25', MINT)}, {c('45m', MINT)}, {c('90s', MINT)} or {c('1h', MINT)};
    anything unparseable keeps the default.

    Answer {c('Sessions today', MINT)} and the row fills in how long the whole run
    takes and the time you'll finish. {c('0', MINT)} means no goal — cycle until you quit.

  {BOLD}SCREEN{RESET}
    pomo takes over the window while it runs and hands it back exactly as it
    was when you quit, leaving one line behind saying what you got done.
    Finished intervals stack up under the one running now.

  {BOLD}KEYS{RESET}
    {c('space', MINT)}         pause / resume
    {c('s', MINT)}             skip to the next interval
    {c('r', MINT)}             restart this interval
    {c('q', MINT)}             quit {DIM}(Ctrl+C works too){RESET}

  {BOLD}SETTINGS{RESET}
    {c(str(PATH), MINT)}

    Rewritten after every run, so it always holds your last session. Edit it
    for the things setup doesn't ask about — alarm sound, volume, bar width,
    and whether to post a desktop notification.

    The sound is a bundled name ({c('Glass', MINT)} on macOS, {c('complete', MINT)} on Linux,
    {c('chimes', MINT)} on Windows…) or a path of your own: {c('~/Documents/ping.wav', MINT)}.
    Empty means silence.

  {BOLD}PORTABILITY{RESET}
    One file, standard library only, on macOS, Linux and Windows. The player
    and notifier are found at runtime — {c('afplay', MINT)}, {c('paplay', MINT)}/{c('ffplay', MINT)}/{c('mpv', MINT)}/{c('aplay', MINT)},
    or Windows' built-in {c('winsound', MINT)}. With none of them, pomo runs quiet.
""")

# ── Main ────────────────────────────────────────────────────────────────────

def windows_console():
    """Teach the Windows console the two things it doesn't assume.

    Without ENABLE_VIRTUAL_TERMINAL_PROCESSING the escape codes print as
    literal garbage; without UTF-8 the braille and the tomato raise
    UnicodeEncodeError. Both are no-ops on a console that's already fine.
    """
    import ctypes
    kernel32 = ctypes.windll.kernel32
    kernel32.SetConsoleMode(kernel32.GetStdHandle(-11), 7)
    sys.stdout.reconfigure(encoding="utf-8")

def main():
    if WINDOWS:
        windows_console()
    if len(sys.argv) > 1:
        return show_help()
    if not sys.stdin.isatty():
        return print("  pomo needs a terminal — run it directly")

    with fullscreen():
        cfg = setup(load())
        save(cfg)
        try:
            done, focused = run(cfg)
        except KeyboardInterrupt:
            done, focused = 0, 0

    # Back on the shell's own screen — leave just the takeaway behind.
    if done:
        target = f" of {cfg['sessions']}" if cfg["sessions"] else ""
        party = "  🎉" if cfg["sessions"] and done >= cfg["sessions"] else ""
        print(f"\n  {c('✓', BOLD + MINT)} {c(done, BOLD + WHITE)}{target} focus sessions  {DIM}·{RESET}  "
              f"{c(span(focused), BOLD + WHITE)} focused{party}\n")
    else:
        print(f"\n  {c('·', DIM)} Nothing finished\n")

if __name__ == "__main__":
    main()
